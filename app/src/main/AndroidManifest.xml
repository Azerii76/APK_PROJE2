<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.otoservice">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- HATA DÜZELTMESİ: Konumun gerçekten değişmesi için zorunlu olan izin eklendi. -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" />

    <!-- Mesajlaşma/sosyal medya uygulamalarını görebilmek için gerekli görünürlük bildirimleri -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.discord" />
        <package android:name="com.viber.voip" />
        <package android:name="com.skype.raider" />
        <package android:name="com.tinder" />
        <package android:name="com.bumble.app" />
        <package android:name="com.ftw_and_co.happn" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.signal.android" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.samsung.android.messaging" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="OtoService"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OtoService">
        <activity
            android:name="com.otoservice.LicenseActivity"
            android:exported="false" />
        <activity
            android:name="com.otoservice.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OtoService">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.otoservice.AutomationService"
            android:exported="false"
            android:label="OtoService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name="com.otoservice.LocationAutomationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
